    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.0",
    "vitest": "4.1.10"
  }
}
